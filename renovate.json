{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableDependencyDashboard"
  ],
  "labels": ["dependencies"],
  "postUpdateOptions": ["gomodTidy"],
  "semanticCommits": "disabled",
  "commitMessagePrefix": ":arrow_up:",
  "commitMessageAction": "chore(deps): update",
  "ignorePaths": [
    "references/**",
    "bin/**",
    ".task/**"
  ],
  "pip-compile": {
    "managerFilePatterns": ["/^docs/requirements-docs\\.txt$/"]
  },
  "pip_requirements": {
    "enabled": false
  },
  "mise": {
    "enabled": false
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Annotated Taskfile tool versions",
      "managerFilePatterns": ["/Taskfile\\.yml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s+[A-Z0-9_]+_VERSION: (?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "{{datasource}}",
      "depNameTemplate": "{{depName}}"
    },
    {
      "customType": "regex",
      "description": "Pinned gitleaks release download in CI",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yaml$/"],
      "matchStrings": [
        "releases/download/v[0-9.]+/gitleaks_(?<currentValue>[0-9.]+)_linux_x64\\.tar\\.gz"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "gitleaks/gitleaks",
      "autoReplaceStringTemplate": "releases/download/v{{{newValue}}}/gitleaks_{{{newValue}}}_linux_x64.tar.gz"
    },
    {
      "customType": "regex",
      "description": "Pinned ShellCheck release download in CI",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yaml$/"],
      "matchStrings": [
        "releases/download/v[0-9.]+/shellcheck-v(?<currentValue>[0-9.]+)\\.linux\\.x86_64\\.tar\\.xz"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "koalaman/shellcheck",
      "autoReplaceStringTemplate": "releases/download/v{{{newValue}}}/shellcheck-v{{{newValue}}}.linux.x86_64.tar.xz"
    },
    {
      "customType": "regex",
      "description": "Helm release versions in CI and install scripts",
      "managerFilePatterns": [
        "/^\\.github/(actions|workflows)/.+\\.ya?ml$/",
        "/^hack/install-helm\\.sh$/"
      ],
      "matchStrings": [
        "HELM_VERSION[^\\n]*?(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "helm/helm"
    },
    {
      "customType": "regex",
      "description": "go-task versions in the CI actions AND the mise.toml pin that mirrors them. Both resolve to depName go-task/task and both are custom.regex, so the 'pinned build tools' rule below lands them in ONE pull request instead of letting mise.toml go stale behind a workflow bump -- the same reasoning as the helm/helm rule. hack/test/dev_mise_pin_drift_test.sh is the fail-closed backstop if this ever stops matching.",
      "managerFilePatterns": [
        "/^\\.github/(actions|workflows)/.+\\.ya?ml$/",
        "/^mise\\.toml$/"
      ],
      "matchStrings": [
        "uses: go-task/setup-task@[^#\\n]+(?:#[^\\n]+)?\\n\\s+with:\\n\\s+version: (?<currentValue>[0-9.]+)",
        "^task = \"(?<currentValue>[0-9.]+)\"$"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "go-task/task"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "groupName": "go minor and patch dependencies",
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "matchManagers": ["gomod"],
      "matchPackageNames": ["/^k8s\\.io\\//", "/^sigs\\.k8s\\.io\\//"],
      "groupName": "kubernetes packages"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "pinDigests": true
    },
    {
      "matchManagers": ["dockerfile"],
      "groupName": "docker images",
      "pinDigests": true
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["docs/**"],
      "groupName": "docs npm dependencies"
    },
    {
      "matchManagers": ["pip-compile"],
      "matchFileNames": ["docs/**"],
      "groupName": "docs Python dependencies"
    },
    {
      "matchManagers": ["custom.regex"],
      "groupName": "pinned build tools"
    },
    {
      "description": "Keep every Helm pin on one version. The azure/setup-helm input in release.yaml is seen by the github-actions manager while the annotated HELM_VERSION pins are seen by the custom manager, so without this they land in different groups and drift apart -- which is exactly how release.yaml reached v3.21.4 while CI stayed on v3.17.3. Both resolve to depName helm/helm.",
      "matchDepNames": ["helm/helm"],
      "groupName": "helm"
    }
  ]
}
