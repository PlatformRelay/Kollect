# Build the kollect-pipeline CLI binary (ADR-0801 pipeline mode).
# Same source tree, builder image, and hardening posture as the operator Dockerfile;
# only the entrypoint (./cmd/cli vs ./cmd) and runtime base differ.
FROM golang:1.27.4@sha256:5e8afd493a7124a8586e134d9b532731161d4b9becf9dee5a5956b107426f93d AS builder
ARG TARGETOS
ARG TARGETARCH
# VERSION-01: build-stamped version (internal/version), passed via --build-arg at release time.
# Defaults keep local `docker build` (no build-args) working, matching internal/version's own
# go-build defaults.
ARG VERSION=dev
ARG COMMIT=unknown
ARG DATE=unknown

WORKDIR /workspace
# Copy the Go Modules manifests
COPY go.mod go.mod
COPY go.sum go.sum
# cache deps before building and copying source so that we don't need to re-download as much
# and so that source changes don't invalidate our downloaded layer
RUN go mod download

# Copy the Go source (relies on .dockerignore to filter)
COPY . .

# Build. GOARCH has no default so the binary matches the host/buildx platform.
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -ldflags="-w -s \
    -X github.com/platformrelay/kollect/internal/version.Version=${VERSION} \
    -X github.com/platformrelay/kollect/internal/version.Commit=${COMMIT} \
    -X github.com/platformrelay/kollect/internal/version.Date=${DATE}" \
    -a -o kollect-pipeline ./cmd/cli

# Runtime image: distroless static nonroot. Unlike the operator image, the pipeline CLI does not
# ship the git/openssh binaries: the git snapshot sink's only export engine is the pure-Go go-git
# (internal/sink/git/config.go, ADR-0803), which needs no external tooling. `file://` git remotes
# (which shell out to git) are therefore unsupported in this minimal image; go-git over HTTPS, the
# local filesystem sink, and the object-store sinks (s3/gcs) all work. ca-certificates and tzdata
# ship in the distroless base, so TLS to sink endpoints works out of the box.
FROM gcr.io/distroless/static:nonroot@sha256:aafe993665bf6200db38a02c11a9351e782a84b6a45e7f33b6695638c88e3931
WORKDIR /
COPY --from=builder /workspace/kollect-pipeline /kollect-pipeline
USER 65532:65532

ENTRYPOINT ["/kollect-pipeline"]
